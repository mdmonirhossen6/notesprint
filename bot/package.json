{
  "name": "notesprint-bot",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "NoteSprint Telegram bot",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --max-semi-space-size=2 --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --max-semi-space-size=2 --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node --max-semi-space-size=2 --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/config.test.ts tests/db.test.ts tests/auth.test.ts tests/server.test.ts tests/channels.test.ts tests/membership.test.ts tests/files.test.ts tests/compression.test.ts tests/stateless.test.ts tests/merge.test.ts tests/organize.test.ts tests/raster.test.ts tests/nup.test.ts tests/tools.test.ts tests/workspace.test.ts tests/ux.test.ts",
    "benchmark": "node --import tsx scripts/benchmark-tools.ts && node --import tsx scripts/benchmark-workspace.ts",
    "set-webhook": "node --env-file-if-exists=.env --import tsx scripts/set-webhook.ts",
    "delete-webhook": "node --env-file-if-exists=.env --import tsx scripts/delete-webhook.ts",
    "bot-api-logout": "node --env-file-if-exists=.env --import tsx scripts/bot-api-logout.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "grammy": "^1.46.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
