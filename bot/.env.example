# Copy this file to bot/.env for local development.
# On Render, set these in Dashboard -> Environment instead.
# Never commit bot/.env and never paste secrets into chat or logs.

NODE_ENV=development
LOG_LEVEL=info

# REQUIRED. Create a NEW bot token with @BotFather.
# Do NOT reuse the token that is still present in the website's git history.
BOT_TOKEN=

# REQUIRED. Numeric Telegram ID of the super admin (not a username).
SUPER_ADMIN_ID=6885443469

# polling for local development, webhook for Render production.
BOT_MODE=polling

# Required only when BOT_MODE=webhook. Must be https.
# Render example: https://<service-name>.onrender.com/telegram
WEBHOOK_URL=
# 16-256 chars: letters, digits, _ or -. Sent by Telegram in a secret header.
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram
# Render sets PORT automatically; this value is only used locally.
PORT=8080

# Static membership gate. Comma-separated @usernames or numeric -100... chat IDs.
# The bot must be an administrator in every channel listed here.
# Leave empty to disable the gate.
REQUIRED_CHANNELS=@prostutihsc,@admissionfreepdf
MEMBERSHIP_CACHE_TTL_SECONDS=180

# Promotion button target in the main menu.
PROSTUTI_APP_URL=https://prostuti.bd

# Telegram Cloud Bot API limits. Do not raise these above 20 and 50.
# Input is 19 MiB, output 49 MB.
MAX_UPLOAD_MB=19
MAX_OUTPUT_MB=49
MAX_PDF_PAGES=300

# Merge PDF limits. Per-file limit is MAX_UPLOAD_MB; these cap one merge job.
MERGE_MAX_FILES=10
MERGE_MAX_TOTAL_MB=40

# Temporary files. Render's disk is ephemeral; the default /tmp is fine.
# Files are deleted after delivery and by the periodic sweep.
TMP_DIR=
TEMP_FILE_TTL_MINUTES=60
MIN_FREE_DISK_MB=64
FILE_TRANSFER_TIMEOUT_SECONDS=120
PROCESS_TIMEOUT_SECONDS=180

# One PDF job at a time keeps memory bounded on the free instance.
PROCESS_CONCURRENCY=1
DOWNLOAD_CONCURRENCY=2

# Per-user upload rate limit (sliding window).
UPLOAD_RATE_LIMIT_COUNT=10
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=60

# The stateless bot uses the standard Cloud Bot API and needs no database,
# Redis, R2/Supabase bucket, Docker, or local Bot API server.
